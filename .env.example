# Copy this file to .env and fill in your values

# PostgreSQL (port 5433 exposed from Docker)
DATABASE_URL_USERS=jdbc:postgresql://localhost:5433/users_db
DATABASE_URL_PRODUCTS=jdbc:postgresql://localhost:5433/products_db
DATABASE_URL_ORDERS=jdbc:postgresql://localhost:5433/orders_db

# MongoDB (port 27018 exposed from Docker)
MONGODB_URL=mongodb://localhost:27018/notifications_db

# Kafka (port 29092 exposed from Docker)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# JWT - must be at least 32 characters
JWT_SECRET=NexaFlowSuperSecretKeyForJWT2024ProdReady

# Optional: Groq AI API key for AI features
GROQ_API_KEY=your_groq_key_here

# Frontend CORS origin
FRONTEND_URL=http://localhost:5174

# Grafana admin password
GRAFANA_PASSWORD=admin123
